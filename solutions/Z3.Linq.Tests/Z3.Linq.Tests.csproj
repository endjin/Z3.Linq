<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Z3.Linq.Tests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Brings in the Microsoft Code Coverage and TRX report MTP extensions. -->
    <TestingExtensionsProfile>Default</TestingExtensionsProfile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Z3.Linq\Z3.Linq.csproj" />
    <!-- The acceptance tests solve the sample theorems as published. Examples adds no packages
         of its own; it references only Z3.Linq. -->
    <ProjectReference Include="..\Z3.Linq.Examples\Z3.Linq.Examples.csproj" />
  </ItemGroup>

</Project>
